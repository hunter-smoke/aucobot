# Database (PostgreSQL)
DATABASE_URL="postgresql://aucobot:aucobot@localhost:5432/aucobot?schema=public"

# API server
API_PORT=8387
WEB_ORIGIN="http://localhost:8386"
NODE_ENV=development
SWAGGER_ENABLED=true

# Auth (JWT httpOnly cookie)
JWT_SECRET="dev-jwt-secret-change-me-in-production-min-32-chars"
JWT_EXPIRES_IN=7d
AUTH_COOKIE_MAX_AGE_MS=604800000

# Google OAuth (Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8387/api/auth/google/callback

# Next.js
NEXT_PUBLIC_API_URL="http://localhost:8387"
