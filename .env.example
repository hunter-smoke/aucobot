# ----------------------------- NESTJS Backend -----------------------------

# Database (PostgreSQL)
DATABASE_URL="postgresql://aucobot:aucobot@localhost:5432/aucobot?schema=public"

# API server — dev: WEB_ORIGIN = app path on same host; prod: https://app.aucobot.com
API_PORT=8387
WEB_ORIGIN="http://localhost:8386/app"
MARKETING_ORIGIN="http://localhost:8386"
NODE_ENV=development
SWAGGER_ENABLED=true

# Auth (JWT httpOnly cookie)
JWT_SECRET="dev-jwt-secret-change-me-in-production-min-32-chars"
JWT_ACCESS_EXPIRES_IN=15m
AUTH_ACCESS_COOKIE_MAX_AGE_MS=900000
REFRESH_TOKEN_EXPIRES_IN_DAYS=3
AUTH_REFRESH_COOKIE_MAX_AGE_MS=2592000000

# Production only — share cookies across www / app / api (e.g. .aucobot.com)
# AUTH_COOKIE_DOMAIN=.aucobot.com

# Google OAuth (Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8387/api/auth/google/callback

# Email (Resend — transactional)
RESEND_API_KEY=
EMAIL_FROM="Aucobot <noreply@aucobot.com>"
EMAIL_OTP_EXPIRES_MINUTES=10
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_IP_MAX_REQUESTS=10
EMAIL_OTP_IP_WINDOW_SECONDS=600

# HMAC secret để hash OTP trước khi lưu DB — nên khác JWT_SECRET
# [DEPLOY] Bắt buộc set secret riêng ≥32 ký tự, generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_OTP_HMAC_SECRET="dev-otp-hmac-secret-change-me-in-production-min-32-chars"

# Redis deploy only (OTP rate limits + future BullMQ / cron)
REDIS_URL="redis://localhost:6379"
REDIS_KEY_PREFIX="aucobot:"

# Feature plugins bật/tắt (CSV). MVP rỗng. Id hợp lệ: facebook,tiktok,publishing,
# approvals,documents,web-search,ai-orchestration. Id lạ → lỗi boot.
ENABLED_FEATURES=


# ----------------------------- NEXTJS Frontend -----------------------------

NEXT_PUBLIC_API_URL="http://localhost:8387"

# Dev: localhost:8386/app + localhost:8386. Prod: app.aucobot.com + www.aucobot.com
NEXT_PUBLIC_APP_URL="http://localhost:8386/app"
NEXT_PUBLIC_MARKETING_URL="http://localhost:8386"

# Waitlist landing → Google Sheet. URL Web App của Google Apps Script (doPost).
# Server-only (KHÔNG NEXT_PUBLIC). Đặt trong apps/web/.env.local. Trống → nút waitlist báo "chưa cấu hình".
WAITLIST_SHEET_WEBHOOK_URL=




