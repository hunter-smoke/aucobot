# Database (PostgreSQL)
DATABASE_URL="postgresql://aucobot:aucobot@localhost:5432/aucobot?schema=public"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# Feature plugins (comma-separated)
ENABLED_FEATURES=builtin,web-search,ai-orchestration,facebook,publishing

# API server
API_PORT=4000
WEB_ORIGIN="http://localhost:3000"
NODE_ENV=development

# Auth (JWT httpOnly cookie)
JWT_SECRET="dev-jwt-secret-change-me-in-production-min-32-chars"
JWT_EXPIRES_IN=7d

# Together AI (llm-services / ai-orchestration)
TOGETHER_API_KEY=

# Tavily (integrations/web-search)
TAVILY_API_KEY=

# Next.js
NEXT_PUBLIC_API_URL="http://localhost:4000"
