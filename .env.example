# Database (PostgreSQL)
DATABASE_URL="postgresql://aucobot:aucobot@localhost:5432/aucobot?schema=public"

# API server
API_PORT=8387
WEB_ORIGIN="http://localhost:8386"
NODE_ENV=development
SWAGGER_ENABLED=true

# Auth (JWT httpOnly cookie)
JWT_SECRET="dev-jwt-secret-change-me-in-production-min-32-chars"
JWT_ACCESS_EXPIRES_IN=15m
AUTH_ACCESS_COOKIE_MAX_AGE_MS=900000
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
AUTH_REFRESH_COOKIE_MAX_AGE_MS=2592000000

# Google OAuth (Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8387/api/auth/google/callback

# Email (Resend — transactional)
RESEND_API_KEY=
# Use verified Resend domain (e.g. send.aucobot.com). Sandbox: onboarding@resend.dev
EMAIL_FROM="Aucobot <noreply@send.aucobot.com>"
EMAIL_VERIFICATION_EXPIRES_HOURS=24
UNVERIFIED_USER_TTL_HOURS=72

# Next.js
NEXT_PUBLIC_API_URL="http://localhost:8387"
